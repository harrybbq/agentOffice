{
  "name": "office",
  "displayName": "Office",
  "hq": "hq.json",
  "branch": "branch.json",
  "background": "#2b2d42",
  "art": {
    "filter": "smooth",
    "furniture": {
      "image": "art/furniture.png",
      "data": "art/furniture.json"
    }
  },
  "corridor": {
    "floor": "#dfe3ea",
    "edge": "#f4f6f9"
  },
  "roles": {
    "boss": {
      "label": "CEO",
      "placeholder": {
        "accessory": "tie",
        "accent": "#c0392b",
        "scale": 1.3
      }
    },
    "manager": {
      "label": "Manager",
      "placeholder": {
        "accessory": "clipboard",
        "accent": "#8d6e63",
        "scale": 1.15
      }
    },
    "worker": {
      "label": "Worker",
      "placeholder": {
        "accessory": "none",
        "accent": "#ffffff",
        "scale": 1.15
      }
    }
  },
  "providers": {
    "default": {
      "tint": "#bab0ac"
    },
    "human": {
      "tint": "#2f3e46"
    },
    "claude-code": {
      "tint": "#d97757"
    },
    "simulate": {
      "tint": "#76b7b2"
    },
    "codex": {
      "tint": "#10a37f"
    },
    "antigravity": {
      "tint": "#5b8def"
    }
  },
  "activities": {
    "read": {
      "location": "filing_cabinet",
      "anim": "work",
      "verb": "Filing"
    },
    "write": {
      "location": "home",
      "anim": "work",
      "verb": "Typing"
    },
    "exec": {
      "location": "server_room",
      "anim": "work",
      "verb": "Running"
    },
    "web": {
      "location": "printer",
      "anim": "work",
      "verb": "Copying"
    },
    "capture": {
      "location": "photo_booth",
      "anim": "work",
      "verb": "Snapping"
    },
    "waiting": {
      "location": "inbox",
      "anim": "idle",
      "verb": "Awaiting sign-off"
    },
    "idle": {
      "location": "home",
      "anim": "idle",
      "verb": ""
    },
    "done": {
      "location": "manager",
      "anim": "carry",
      "verb": "Reporting"
    }
  },
  "stationRules": [
    {
      "detail": "^planning:\\s*",
      "location": "whiteboard",
      "anim": "work",
      "verb": "Planning"
    },
    {
      "detail": "^checking the board",
      "location": "noticeboard",
      "anim": "work",
      "verb": "Checking the board"
    },
    {
      "detail": "^secrets:\\s*",
      "location": "vault",
      "anim": "work",
      "verb": "In the vault"
    },
    {
      "activity": "waiting",
      "detail": "^question:\\s*",
      "location": "inbox",
      "anim": "idle",
      "verb": "Asking"
    },
    {
      "activity": "exec",
      "detail": "^delegating$",
      "location": "home",
      "anim": "work",
      "verb": "Delegating"
    }
  ],
  "idle": {
    "location": "lounge",
    "afterMs": 45000
  },
  "stationLabels": {
    "inbox": {
      "title": "Security gate",
      "subtitle": "Waiting on you",
      "color": "#f0b64f",
